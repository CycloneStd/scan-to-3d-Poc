POSTGRES_DB=scan3d
POSTGRES_USER=scan3d
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

WEBXR_ENVIRONMENT=development
WEBXR_JWT_SECRET=replace-with-at-least-32-random-characters
WEBXR_FRONTEND_BASE_URL=http://localhost:5173
WEBXR_CORS_ORIGINS=http://localhost:5173
WEBXR_SMTP_FROM_EMAIL=no-reply@example.test
WEBXR_UPLOAD_MAX_BYTES=2147483648
WEBXR_PIPELINE_TRACK=mesh
WEBXR_WORKER_CONCURRENCY=1

# Required for Colab-backed dense reconstruction in the worker.
# Store Colab credentials outside the repository. See README.md.
COLAB_CONFIG_DIR=C:/Users/your-name/.config/colab-docker

# For Railway, set these as service variables instead; use a private S3-compatible bucket.
# WEBXR_STORAGE_BACKEND=s3
# WEBXR_STORAGE_S3_BUCKET=your-private-bucket
# WEBXR_STORAGE_S3_REGION=...
# WEBXR_STORAGE_S3_ENDPOINT_URL=...
# WEBXR_STORAGE_S3_PUBLIC_ENDPOINT_URL=...
# WEBXR_STORAGE_S3_ACCESS_KEY=...
# WEBXR_STORAGE_S3_SECRET_KEY=...
